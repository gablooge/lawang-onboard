# Environment variables for Lawang Onboard.
# Copy this file to .env and fill in your own token values.
# Never commit the real .env file (it is in .gitignore).

# Bearer tokens for each demo role. Each variable holds the secret token that
# a client must send in the Authorization: Bearer header to assume that role.
# For stdio transport set ONBOARD_TOKEN to the token for the desired role.
ONBOARD_TOKEN_MAINTAINER=your-maintainer-token-here
ONBOARD_TOKEN_EMPLOYEE=your-employee-token-here
ONBOARD_TOKEN_CONTRACTOR=your-contractor-token-here
